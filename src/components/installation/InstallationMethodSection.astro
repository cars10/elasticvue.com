---
import Button from '../shared/Button.astro'
import type { VariantItem } from '../../data/variants'

interface Props {
  title: string
  description: string
  direction?: 'left' | 'right' | 'center'
  capabilities?: string[]
  variants: VariantItem[]
}
const { title, description, capabilities = [], variants } = Astro.props
---

<div class="gradient px-6 py-10 xl:py-40">
  <div class="mx-auto flex flex-col xl:w-3/4 2xl:w-1/2">
    <div>
      <h1 class="text-3xl xl:text-5xl">{title}</h1>
      {capabilities.length > 0 && (
        <div class="mt-10 flex flex-wrap gap-4 text-gray-300 justify-start">
          {capabilities.map((cap) => (
            <span class="text-nowrap rounded-xl border border-neutral-600 px-3 py-2">
              <span class="text-green-400">✓</span> {cap}
            </span>
          ))}
        </div>
      )}
    </div>
    <p class="my-10 text-muted 2xl:my-20">{description}</p>
    <div class="flex flex-col gap-6 md:flex-row md:gap-10">
      {variants.map((v) => (
        <div class="w-full grow md:w-1/3">
          <div class="flex h-full flex-col rounded-xl border border-neutral-600 bg-neutral-800 px-4 py-6">
            <div class="mb-4 flex items-start justify-between gap-4 text-xl">
              <div class="flex gap-4">
                <img
                  src={v.icon}
                  alt={v.label}
                  width={24}
                  height={24}
                  class="h-6 w-auto"
                />
                {v.label}
              </div>
            </div>
            <p class="mb-6 grow">{v.description}</p>
            <div class="inline-flex">
              <Button
                color="white"
                label={v.buttonLabel || 'Download'}
                href={v.href}
                dropdownItems={v.dropdownItems}
                target="_blank"
              />
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</div>
