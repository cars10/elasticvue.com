---
import Section from '../shared/Section.astro'
import Button from '../shared/Button.astro'
import { variants } from '../../data/variants'
---

<Section
  title="Install it your way."
  description="No matter if you prefer a desktop app, browser extension, docker container or a web app — elasticvue has you covered. You can also easily self-host and deploy your own variant of elasticvue."
  buttonLabel="Installation"
  buttonHref="/installation"
  buttonColor="white"
>
  <div class="mb-8 flex flex-wrap justify-evenly gap-4 text-white xl:mb-20">
    {Object.entries(variants).map(([variantKey, v]) => (
      <Button
        title={v.label}
        href={v.href}
        icon={v.icon}
        dropdownItems={v.dropdownItems}
        iconSize={30}
        hideCaret
        target="_blank"
        class="zoom py-8"
        umamiEvent="availability-button-click"
        umamiVariant={variantKey}
      />
    ))}
  </div>
</Section>
