---
import { Image } from 'astro:assets'
import logo from '../assets/images/logo/blue_96.png'

const links = [
  { label: 'home', href: '/' },
  { label: 'installation', href: '/installation' },
  { label: 'features', href: '/features' },
]
---

<header class="flex w-full text-white">
  <div class="mx-auto flex h-full max-w-[92%] pl-2 flex-1 flex-row justify-between py-4 xl:max-w-3/4 2xl:max-w-1/2">
    <div class="flex flex-1 items-center">
      <a href="/" class="mr-3">
        <Image
          src={logo}
          alt="Elasticvue logo"
          width={52}
          height={52}
          class="w-9 rounded-xl bg-white p-1 shadow-primary shadow-xs hover:shadow-xl xl:w-[52px]"
          loading="eager"
          fetchpriority="high"
        />
      </a>
    </div>

    <nav
      id="nav-menu"
      class="mr-14 hidden py-3 md:flex xl:mr-0"
      aria-label="Main navigation"
    >
      {links.map(({ label, href }) => (
        <a
          href={href}
          class="ml-4 inline-flex h-10 cursor-pointer items-center rounded-xl px-4 py-2 text-nowrap text-neutral-200 shadow-sm transition duration-300 hover:bg-neutral-800 hover:text-white focus:bg-neutral-800 zoom"
        >
          {label}
        </a>
      ))}
    </nav>

    <button
      type="button"
      aria-label="Menu"
      class="mr-1 p-2 md:hidden"
      id="menu-toggle"
    >
      <div class="mb-1 h-1 w-7 rounded-sm bg-white"></div>
      <div class="mb-1 h-1 w-7 rounded-sm bg-white"></div>
      <div class="h-1 w-7 rounded-sm bg-white"></div>
    </button>
  </div>

  <a
    href="https://github.com/cars10/elasticvue"
    rel="noopener"
    target="_blank"
    title="Elasticvue on GitHub"
    aria-label="Elasticvue on GitHub"
    class="hidden xl:inline-block"
  >
    <svg
      class="octocat absolute top-0 right-0 fill-white"
      aria-hidden="true"
      height="78"
      viewBox="0 0 250 250"
      width="78"
    >
      <path d="M0,0 L115,115 L130,115 L142,142 L250,250 L250,0 Z"></path>
      <path
        class="octocat-arm fill-primary"
        style="transform-origin: 130px 106px"
        d="M128.3,109.0 C113.8,99.7 119.0,89.6 119.0,89.6 C122.0,82.7 120.5,78.6 120.5,78.6 C119.2,72.0 123.4,76.3 123.4,76.3 C127.3,80.9 125.5,87.3 125.5,87.3 C122.9,97.6 130.6,101.9 134.4,103.2"
        fill="currentColor"
      ></path>
      <path
        d="M115.0,115.0 C114.9,115.1 118.7,116.5 119.8,115.4 L133.7,101.6 C136.9,99.2 139.9,98.4 142.2,98.6 C133.8,88.0 127.5,74.4 143.8,58.0 C148.5,53.4 154.0,51.2 159.7,51.0 C160.3,49.4 163.2,43.6 171.4,40.1 C171.4,40.1 176.1,42.5 178.8,56.2 C183.1,58.6 187.2,61.8 190.9,65.4 C194.5,69.0 197.7,73.2 200.1,77.6 C213.8,80.2 216.3,84.9 216.3,84.9 C212.7,93.1 206.9,96.0 205.4,96.6 C205.1,102.4 203.0,107.8 198.3,112.5 C181.9,128.9 168.3,122.5 157.7,114.1 C157.9,116.9 156.7,120.9 152.7,124.9 L141.0,136.5 C139.8,137.7 141.6,141.9 141.8,141.8 Z"
        fill="#25315a"
      ></path>
    </svg>
  </a>
</header>

<style is:global>
  .octocat:hover .octocat-arm {
    animation: octocat-wave 750ms ease-in-out;
  }
  @keyframes octocat-wave {
    0%,
    100% {
      transform: rotate(0);
    }
    20%,
    60% {
      transform: rotate(-25deg);
    }
    40%,
    80% {
      transform: rotate(10deg);
    }
  }
  #nav-menu.mobile-open {
    position: absolute;
    top: 4.5rem;
    bottom: 0;
    left: 0;
    z-index: 20;
    display: flex;
    width: 100%;
    flex-direction: column;
    gap: 1rem;
    background: var(--color-primary);
    padding: 1rem;
    box-shadow: var(--shadow-main);
  }
</style>

<script>
  const toggle = document.getElementById('menu-toggle')
  const menu = document.getElementById('nav-menu')
  if (toggle && menu) {
    toggle.addEventListener('click', () => {
      menu.classList.toggle('mobile-open')
      menu.classList.toggle('hidden')
      menu.classList.toggle('flex')
    })
    const menuLinks = menu.querySelectorAll('a')
    menuLinks.forEach((link) => {
      link.addEventListener('click', () => {
        menu.classList.remove('mobile-open', 'flex')
        menu.classList.add('hidden')
      })
    })
  }
</script>
